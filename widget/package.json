{
  "name": "notion-tasks-desktop-widget",
  "version": "1.0.0",
  "type": "module",
  "description": "Sleek Windows Desktop Widget for Notion Tasks (React 19 + Electron + Tailwind CSS + Notion Design System)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"import('fs').then(f => f.copyFileSync('electron/preload.cjs', 'dist-electron/preload.cjs'))\"",
    "preview": "vite preview",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
