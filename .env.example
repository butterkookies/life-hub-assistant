# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Authorized Telegram User IDs (comma-separated, from @userinfobot)
ALLOWED_TELEGRAM_USER_IDS=1234567890

# Google Gemini API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Notion Internal Integration Secret (from https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_your_notion_integration_secret_here

# Daily Morning Briefing Settings (Asia/Manila is UTC+8)
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=06:00
UTC_OFFSET_HOURS=8

# Email Notification Settings
EMAIL_NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_TO=your_email@gmail.com
EMAIL_FROM_NAME="Andrei's Notion AI Assistant"

# Method A: Standard SMTP (e.g. Gmail App Password, SendGrid, Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password

# Method B: Alternative Resend API Key (optional)
# RESEND_API_KEY=re_your_resend_api_key_here
