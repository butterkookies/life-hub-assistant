# ==============================================================================
# Andrei's Life Hub Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Application & Security Settings (Primary Interface)
# ------------------------------------------------------------------------------
# Generate your password hash with: python generate_password_hash.py
WEB_PASSWORD_HASH="pbkdf2:sha256:600000$your_salt_here$your_hash_here"

# A secure random secret string used to sign session cookies (at least 32 characters)
WEB_SESSION_SECRET="your_random_secret_session_key_at_least_32_characters_long"

# Allowed web origins for CORS and CSRF protection (comma-separated)
# Include your Tailscale address e.g. https://your-machine.tailscale-domain.ts.net
WEB_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"

# Session duration in days (default: 30)
WEB_SESSION_DAYS=30

# SQLite is used for local development when DATABASE_URL is empty.
DATABASE_PATH="data/life_hub.db"
DATABASE_URL=""

# Durable object storage. Leave empty for local filesystem storage.
UPLOAD_DIR="data/uploads"
R2_ENDPOINT_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Conservative ceilings below R2's monthly free allowance.
R2_MAX_STORAGE_BYTES=5368709120
R2_MAX_WRITES_31D=100000
R2_MAX_READS_31D=1000000

# Production guardrails and the Cloudflare briefing trigger secret.
DURABLE_STORAGE_REQUIRED=false
BRIEFING_TRIGGER_TOKEN=""

# ------------------------------------------------------------------------------
# 2. Web Push Notifications (Optional - VAPID Keys)
# Generate with: python generate_vapid_keys.py
# ------------------------------------------------------------------------------
WEB_PUSH_VAPID_PUBLIC_KEY="your_vapid_public_key_here"
WEB_PUSH_VAPID_PRIVATE_KEY="your_vapid_private_key_here"
WEB_PUSH_CONTACT="mailto:your_email@example.com"

# ------------------------------------------------------------------------------
# 3. Core AI & Workspace Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Notion Internal Integration Secret (from https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_your_notion_integration_secret_here

# ------------------------------------------------------------------------------
# 4. Daily Morning Briefing Settings (Asia/Manila is UTC+8)
# ------------------------------------------------------------------------------
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=06:00
UTC_OFFSET_HOURS=8

# ------------------------------------------------------------------------------
# 5. Email Notification Settings (Optional)
# ------------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_TO=your_email@gmail.com
EMAIL_FROM_NAME="Andrei's Life Hub Assistant"

# Method A: Standard SMTP (e.g. Gmail App Password, SendGrid, Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password

# Method B: Alternative Resend API Key (optional)
# RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 6. Telegram Bot Settings (Optional Fallback)
# Set ENABLE_TELEGRAM=true only if you want to keep Telegram bot active in parallel
# ------------------------------------------------------------------------------
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_IDS=1234567890

# Server HTTP Port
PORT=8000
